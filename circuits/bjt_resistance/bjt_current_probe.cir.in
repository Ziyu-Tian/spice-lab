Generic NPN controlled three-terminal port: {run_id}
* Isample > 0 enters the collector port; Isample < 0 leaves it.
* Ground is the external emitter. The independent base supply makes this active.
Isample 0 port DC {current_a:.16g} AC 1u
Vcollector port collector DC 0
Q1 collector base emitter GENERIC_NPN
Vemitter emitter 0 DC 0
Rbias supply base 10k
Vbias supply 0 DC {bias_v:.16g}
{model}
.temp {temperature_c:.16g}
.options tnom=25 reltol=1e-7 abstol=1e-13 vntol=1e-10 gmin={gmin_s:.16g}
.control
set noaskquit
set filetype=ascii
set numdgt=15
op
write op.raw v(port) v(base) i(vcollector) i(vbias) i(vemitter) @q1[ic] @q1[ib] @q1[ie] @q1[gm] @q1[gpi] @q1[go]
ac lin 1 1 1
write ac_1.raw v(port)
ac lin 1 1000 1000
write ac_1000.raw v(port)
ac lin 1 100000 100000
write ac_100000.raw v(port)
alter Isample {plus_current_a:.16g}
op
write plus.raw v(port)
alter Isample {minus_current_a:.16g}
op
write minus.raw v(port)
quit
.endc
.end
